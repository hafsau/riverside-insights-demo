{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3412",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3412/",
        "http://localhost:3412/student",
        "http://localhost:3412/educator",
        "http://localhost:3412/educator/mateo-hernandez",
        "http://localhost:3412/educator/mateo-hernandez/family",
        "http://localhost:3412/admin",
        "http://localhost:3412/system",
        "http://localhost:3412/accessibility",
        "http://localhost:3412/about"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-reports" }
  }
}
